# انسخ هذا الملف باسم .env في نفس المجلد وضع مفاتيحك. ملف .env مستثنى من Git (.gitignore) ولا يُرفع.
# المفاتيح من لوحة Alpaca: Paper Trading ← API Keys (مفاتيح حساب Paper، لا الحساب الحقيقي).

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# تشغيل بث Alpaca مع المنصة (1 = نعم)
ALPACA_STREAM=1

# المصدر: sip فقط في هذه المرحلة (iex مرفوض)
ALPACA_FEED=sip

# الرموز لكل قناة: * = كل الأسهم، أو قائمة مثل AAPL,TSLA، أو off لإيقاف القناة.
# تنبيه: الأسعار (quotes) لكل السوق عبر SIP كثيفة جدًا (قد تبلغ عشرات آلاف الرسائل في الثانية)؛ راقب
# msgs_per_s في /api/alpaca/status، وإن ظهر الخطأ 407 slow client فاجعل ALPACA_QUOTES قائمة رموز.
ALPACA_TRADES=*
ALPACA_QUOTES=*
ALPACA_BARS=*

# إعادة الاتصال إذا لم تصل بيانات لهذه الثواني أثناء التداول (4:00–20:00 نيويورك)
ALPACA_STALE_SECONDS=30

# الترميز: msgpack (نصف حجم JSON، الافتراضي) أو json
ALPACA_FORMAT=msgpack
