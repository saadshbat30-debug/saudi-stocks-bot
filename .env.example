# مفتاح API من سهمك: https://www.sahmk.sa/developers
SAHMK_API_KEY=shmk_live_xxxxxxxxxxxxxxxx
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# (اختياري) معرف المحادثة لإرسال ملخص الافتتاح والإغلاق تلقائياً
OWNER_CHAT_ID=
# (اختياري) رابط الخدمة العام لوضع الـ webhook — على Render يُقرأ تلقائياً من RENDER_EXTERNAL_URL
PUBLIC_URL=
# كل كم ثانية يفحص التنبيهات أثناء التداول
ALERT_INTERVAL_SECONDS=60
# كل كم ثانية يفحص الأخبار الجديدة لأسهم قوائم المتابعة
EVENTS_INTERVAL_SECONDS=300
# 1 لتفعيل البث المباشر (WebSocket) للتنبيهات اللحظية، 0 لتعطيله
ENABLE_STREAM=1
