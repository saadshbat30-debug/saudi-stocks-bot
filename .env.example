# انسخ هذا الملف باسم .env في نفس المجلد وضع مفاتيحك. ملف .env مستثنى من Git (.gitignore) ولا يُرفع.
# المفاتيح من لوحة Alpaca: Paper Trading ← API Keys (مفاتيح حساب Paper، لا الحساب الحقيقي).

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# مصدر بيانات المنصة: alpaca = الأسعار والتغير والحجم وأعلى/أدنى اليوم والشارت من Alpaca SIP
# (قائمة الأسهم والبيانات الأساسية تبقى من ياهو: Alpaca لا يوفر الاسم والقيمة السوقية والأسهم الحرة ومتوسط الحجم).
# احذف السطر للعودة إلى ياهو.
DATA_SOURCE=alpaca

# أو بث Alpaca وحده دون تغيير مصدر المنصة (للتجربة):
# ALPACA_STREAM=1

# المصدر: sip فقط في هذه المرحلة (iex مرفوض)
ALPACA_FEED=sip

# الرموز لكل قناة: * = كل الأسهم · watch = الأسهم التي تتابعها المنصة الآن (صفحة السهم وأنشط 40 سهمًا) ·
# قائمة مثل AAPL,TSLA (+ المتابعة) · off. مع DATA_SOURCE=alpaca الافتراضي: الشموع اليومية لكل السوق والباقي watch،
# لأن كل صفقات السوق لا يحملها اتصال إلى أمريكا من السعودية (فحص 2026-11-18: تأخر حتى 32 ث).
# تنبيه: الأسعار (quotes) لكل السوق عبر SIP كثيفة جدًا (قد تبلغ عشرات آلاف الرسائل في الثانية)؛ راقب
# msgs_per_s في /api/alpaca/status، وإن ظهر الخطأ 407 slow client فاجعل ALPACA_QUOTES قائمة رموز.
ALPACA_TRADES=watch
ALPACA_QUOTES=watch
ALPACA_BARS=watch
ALPACA_DAILY=*
# أقصى عدد أسهم بصفقات لحظية
ALPACA_WATCH_MAX=60

# إعادة الاتصال إذا لم تصل بيانات لهذه الثواني أثناء التداول (4:00–20:00 نيويورك)
ALPACA_STALE_SECONDS=30

# الترميز: msgpack (نصف حجم JSON، الافتراضي) أو json
ALPACA_FORMAT=msgpack
